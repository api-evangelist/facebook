{
  "opencollection": "1.0.0",
  "info": {
    "name": "Facebook Graph Ad Accounts Replies API",
    "version": "21.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Replies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Facebook Get Threads Replies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.facebook.com/v21.0/:threads-media-id/replies",
            "params": [
              {
                "name": "threads-media-id",
                "value": "98765432101234567",
                "type": "path",
                "description": "The Threads media ID."
              }
            ]
          },
          "docs": "Retrieve replies to a Threads post."
        }
      ]
    }
  ],
  "bundled": true
}